---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
---

<div
  id="btt-btn-container"
  hidden
  aria-hidden="true"
  class:list={[
    "fixed end-4 bottom-8 z-50",
    "md:end-8 md:bottom-10",
    "translate-y-5 opacity-0 transition duration-500",
  ]}
>
  <button
    data-button="back-to-top"
    type="button"
    aria-label="返回顶部"
    disabled
    class:list={[
      "group relative flex flex-col items-center justify-center gap-0.5",
      "size-14 rounded-full",
      "md:size-16",
      "shadow-[0_4px_20px_rgba(0,0,0,0.20)] dark:shadow-[0_4px_20px_rgba(0,0,0,0.60)]",
      "hover:shadow-[0_6px_28px_rgba(0,0,0,0.30)] dark:hover:shadow-[0_6px_28px_rgba(0,0,0,0.75)]",
      "hover:scale-105 active:scale-95",
      "transition-all duration-200 ease-out",
    ]}
  >
    <!-- 1: Anillo de progreso (conic-gradient) -->
    <span
      id="progress-indicator"
      class="absolute inset-0 z-0 block rounded-full bg-transparent"></span>
    <!-- 2: Fondo del botón, deja 3px de anillo visible -->
    <span
      class="absolute inset-[3px] z-10 rounded-full bg-background backdrop-blur-md"
    ></span>
    <!-- 3: Contenido (icono + etiqueta) -->
    <IconArrowNarrowUp
      class="relative z-20 size-5 text-accent transition-transform duration-200 group-hover:-translate-y-0.5 md:size-6"
    />
    <span
      class="relative z-20 text-[9px] font-bold tracking-widest text-accent/70 uppercase"
    >
      top
    </span>
  </button>
</div>

<script is:inline data-astro-rerun>
  (() => {
    window.__cleanupBackToTop?.();
    const root = document.documentElement;
    const container = document.querySelector("#btt-btn-container");
    const button = container?.querySelector("[data-button='back-to-top']");
    const progress = container?.querySelector("#progress-indicator");
    if (!container || !button || !progress) return;

    const controller = new AbortController();
    const options = { signal: controller.signal };
    let frame = 0;
    const update = () => {
      const total = Math.max(0, root.scrollHeight - root.clientHeight);
      const ratio = total > 0 ? Math.min(1, Math.max(0, root.scrollTop / total)) : 0;
      const percent = Math.floor(ratio * 100);
      const visible = ratio > 0.2;
      container.hidden = !visible;
      container.setAttribute("aria-hidden", String(!visible));
      button.disabled = !visible;
      container.classList.toggle("opacity-100", visible);
      container.classList.toggle("translate-y-0", visible);
      container.classList.toggle("opacity-0", !visible);
      container.classList.toggle("translate-y-5", !visible);
      progress.style.setProperty("background-image",
        `conic-gradient(var(--accent), var(--accent) ${percent}%, transparent ${percent}%)`);
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(() => { frame = 0; update(); });
    };
    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, left: 0, behavior: "instant" });
      const target = document.querySelector("main");
      if (target) {
        const previous = target.getAttribute("tabindex");
        target.setAttribute("tabindex", "-1");
        target.focus({ preventScroll: true });
        target.addEventListener("blur", () => {
          if (previous === null) target.removeAttribute("tabindex");
          else target.setAttribute("tabindex", previous);
        }, { ...options, once: true });
      }
      update();
    }, options);
    document.addEventListener("scroll", schedule, { ...options, passive: true });
    window.addEventListener("resize", schedule, options);
    window.addEventListener("pageshow", schedule, options);
    document.addEventListener("astro:page-load", schedule, options);
    const cleanup = () => {
      controller.abort();
      cancelAnimationFrame(frame);
      if (window.__cleanupBackToTop === cleanup) delete window.__cleanupBackToTop;
    };
    window.__cleanupBackToTop = cleanup;
    document.addEventListener("astro:before-swap", cleanup, { ...options, once: true });
    update();
    schedule();
  })();
</script>
